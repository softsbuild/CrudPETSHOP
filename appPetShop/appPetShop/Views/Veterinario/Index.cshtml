@model IEnumerable<appPetShop.Models.Veterinario>

@{
    ViewData["Title"] = "Corpo Clínico";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h3 class="mb-0 text-primary fw-bold"><i class="bi bi-hospital me-2"></i>Veterinários</h3>
        <a asp-action="Create" class="btn btn-primary fw-semibold">
            <i class="bi bi-plus-circle me-1"></i>Novo Veterinário
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">@Html.DisplayNameFor(model => model.Nome)</th>
                        <th>CRMV</th>
                        <th>@Html.DisplayNameFor(model => model.Especialidade)</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">
                                @Html.DisplayFor(modelItem => item.Nome)
                            </td>
                            <td><span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.Crmv)</span></td>
                            <td>@Html.DisplayFor(modelItem => item.Especialidade)</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-outline-info" title="Detalhes"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>